<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Category -->
        <record id="module_category_agency" model="ir.module.category">
            <field name="name">Agency Management</field>
            <field name="description">Helps you manage your agency projects and teams.</field>
            <field name="sequence">20</field>
        </record>

        <!-- Privilege (Odoo 19 uses this instead of category directly on groups) -->
        <record id="res_groups_privilege_agency" model="res.groups.privilege">
            <field name="name">Agency</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_agency"/>
        </record>

        <!-- Groups -->
        <record id="group_agency_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="privilege_id" ref="res_groups_privilege_agency"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can see their own tasks and team projects.</field>
        </record>

        <record id="group_agency_team_manager" model="res.groups">
            <field name="name">Team Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_agency"/>
            <field name="implied_ids" eval="[(4, ref('group_agency_employee'))]"/>
            <field name="comment">Can manage their own team and team projects.</field>
        </record>

        <record id="group_agency_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_agency"/>
            <field name="implied_ids" eval="[(4, ref('group_agency_team_manager'))]"/>
            <field name="comment">Full access to agency management including configuration and overrides.</field>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_agency_finance" model="res.groups">
            <field name="name">Finance</field>
            <field name="privilege_id" ref="res_groups_privilege_agency"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view financial metrics (Revenue, Cost, Profit).</field>
        </record>

        <!-- Record Rules -->
        <record id="agency_project_employee_rule" model="ir.rule">
            <field name="name">Employee Project Access</field>
            <field name="model_id" ref="model_agency_project"/>
            <field name="domain_force">[('assigned_team_id.member_ids.employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_agency_employee'))]"/>
        </record>

        <record id="agency_project_manager_rule" model="ir.rule">
            <field name="name">Team Manager Project Access</field>
            <field name="model_id" ref="model_agency_project"/>
            <field name="domain_force">[('assigned_team_id.manager_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_agency_team_manager'))]"/>
        </record>

        <record id="agency_project_admin_rule" model="ir.rule">
            <field name="name">Admin Project Access</field>
            <field name="model_id" ref="model_agency_project"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_agency_admin'))]"/>
        </record>

    </data>
</odoo>
