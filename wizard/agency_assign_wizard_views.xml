<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agency_assign_wizard_form" model="ir.ui.view">
        <field name="name">agency.assign.wizard.form</field>
        <field name="model">agency.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Manual Assignment Override">
                <group>
                    <field name="project_id" readonly="1"/>
                    <field name="team_id" options="{'no_create': True}"/>
                    <field name="reason" placeholder="State the reason for this manual override..."/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Confirm Override" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_agency_assign_wizard" model="ir.actions.act_window">
        <field name="name">Override Assignment</field>
        <field name="res_model">agency.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
