<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Agency Teams -->
        <record id="seq_agency_team" model="ir.sequence">
            <field name="name">Agency Team</field>
            <field name="code">agency.team</field>
            <field name="prefix">AGT-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Agency Projects -->
        <record id="seq_agency_project" model="ir.sequence">
            <field name="name">Agency Project</field>
            <field name="code">agency.project</field>
            <field name="prefix">AGP-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
