<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View: Tree -->
    <record id="view_agency_assignment_history_list" model="ir.ui.view">
        <field name="name">agency.assignment.history.tree</field>
        <field name="model">agency.assignment.history</field>
        <field name="arch" type="xml">
            <list string="Assignment History" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="agency_project_id"/>
                <field name="team_id"/>
                <field name="previous_team_id"/>
                <field name="score" widget="percentage"/>
                <field name="assigned_by"/>
                <field name="is_auto"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_agency_assignment_history" model="ir.actions.act_window">
        <field name="name">Assignment History</field>
        <field name="res_model">agency.assignment.history</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
